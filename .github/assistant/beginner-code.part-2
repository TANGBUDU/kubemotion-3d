+.teaching-plain-language {
+  padding: 11px 12px;
+  border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border));
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--accent) 8%, transparent);
+}
+
+.teaching-plain-language > div {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  margin-bottom: 6px;
+  color: var(--accent);
+}
+
+.teaching-plain-language h3 {
+  margin: 0;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.teaching-plain-language p {
+  margin: 0;
+  color: #eef7ff;
+  font-size: 13px;
+  font-weight: 560;
+  line-height: 1.52;
+}
+
+.teaching-focus-hint {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  padding: 8px 10px;
+  border-radius: 10px;
+  background: rgb(8 20 34 / 58%);
+  color: var(--warning);
+}
+
+.teaching-focus-hint > div {
+  display: grid;
+  min-width: 0;
+  gap: 2px;
+}
+
+.teaching-focus-hint span {
+  color: var(--warning);
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+
+.teaching-focus-hint strong {
+  color: var(--text-primary);
+  font-size: 11px;
+  line-height: 1.4;
+}
+
 .teaching-section h3,
 .teaching-takeaway h3 {
   margin: 0 0 5px;
